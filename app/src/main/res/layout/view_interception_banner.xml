<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_banner"
    android:padding="@dimen/padding_medium">

    <!-- Row: icon + title + time -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/bannerIcon"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_app_placeholder"
            android:contentDescription="App icon" />

        <TextView
            android:id="@+id/bannerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/margin_medium"
            android:text="WhatsApp"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_default"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/bannerTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12:30"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_small" />

        <ImageView
            android:id="@+id/bannerClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="@dimen/margin_small"
            android:src="@drawable/ic_close"
            android:contentDescription="Dismiss"
            android:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- Content row: message preview + actions -->
    <TextView
        android:id="@+id/bannerText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:layout_marginStart="48dp"
        android:text="Message preview here"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_medium"
        android:maxLines="2"
        android:ellipsize="end" />

    <LinearLayout
        android:id="@+id/bannerActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_small"
        android:orientation="horizontal"
        android:gravity="end"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannerBtnSecondary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Decline"
            android:textColor="@color/danger_red" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bannerBtnPrimary"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/margin_small"
            android:text="Answer"
            android:textColor="@color/success_green" />
    </LinearLayout>
</LinearLayout>
