<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/padding_medium">

    <ImageView
        android:id="@+id/heatmapImageView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="fitCenter"
        android:src="@drawable/default_controller" />

    <TextView
        android:id="@+id/tvCentroids"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/padding_medium"
        android:text="No touch data yet. Play a match with the heatmap recorder on."
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_small" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSuggestPositions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/analytics_suggest"
        android:textColor="@color/primary_black"
        app:icon="@drawable/ic_crosshair"
        app:iconTint="@color/primary_black"
        app:iconGravity="textStart"
        android:backgroundTint="@color/primary_cyan"
        app:cornerRadius="@dimen/button_corner_radius" />
</LinearLayout>
